# Copy to .env and fill in (see docker-compose.yml). .env is gitignored.

# Soulseek credentials
SLDL_USER=your-soulseek-username
SLDL_PASS=your-soulseek-password

# Optional AcoustID key for fingerprint verification: https://acoustid.org/new-application
ACOUSTID_KEY=

# Host paths to mount when deploying (see docker-compose.yml volumes)
MUSIC_LIB=/path/to/your/music/library
INBOX=/path/to/your/download/inbox
